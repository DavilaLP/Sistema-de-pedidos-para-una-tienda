{
  "info": {
    "name": "Sistema de Pedidos - APF2",
    "description": "Pruebas automáticas con JWT e IDs dinámicos. Ejecutar la colección completa en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "admin_username", "value": "admin" },
    { "key": "admin_password", "value": "admin123" },
    { "key": "jwt_token", "value": "" },
    { "key": "producto_id", "value": "" },
    { "key": "pedido_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{jwt_token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "01 - Login",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{admin_username}}\",\"password\":\"{{admin_password}}\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('jwt_token', '');",
              "pm.collectionVariables.set('producto_id', '');",
              "pm.collectionVariables.set('pedido_id', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login responde 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Recibe JWT y rol ADMIN', function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.token).to.be.a('string').and.not.empty;",
              "  pm.expect(data.role).to.eql('ADMIN');",
              "  pm.collectionVariables.set('jwt_token', data.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Crear producto de prueba",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Monitor de prueba APF2\",\"price\":450,\"stock\":10}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Crear producto responde 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Producto creado correctamente', function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.id).to.be.a('number').and.above(0);",
              "  pm.expect(data.name).to.eql('Monitor de prueba APF2');",
              "  pm.expect(data.price).to.eql(450);",
              "  pm.expect(data.stock).to.eql(10);",
              "  pm.collectionVariables.set('producto_id', data.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Listar productos",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listar productos responde 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Catalogo incluye el producto creado', function () {",
              "  const data = pm.response.json();",
              "  const id = Number(pm.collectionVariables.get('producto_id'));",
              "  pm.expect(data).to.be.an('array');",
              "  pm.expect(data.some(p => p.id === id)).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Obtener producto por ID",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/products/{{producto_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Consultar producto responde 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Recupera el producto correcto', function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.id).to.eql(Number(pm.collectionVariables.get('producto_id')));",
              "  pm.expect(data.stock).to.eql(10);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Producto inexistente",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/products/0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Producto inexistente responde 404', function () { pm.response.to.have.status(404); });",
              "pm.test('Error 404 tiene estructura correcta', function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.status).to.eql(404);",
              "  pm.expect(data.error).to.eql('Not Found');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Validar producto incorrecto",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"\",\"price\":-10,\"stock\":-5}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Producto invalido responde 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Devuelve error de validacion', function () {",
              "  pm.expect(pm.response.json().error).to.eql('Validation Error');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Actualizar producto de prueba",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/products/{{producto_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Monitor actualizado APF2\",\"price\":500,\"stock\":20}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Actualizar producto responde 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Producto actualizado correctamente', function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.name).to.eql('Monitor actualizado APF2');",
              "  pm.expect(data.price).to.eql(500);",
              "  pm.expect(data.stock).to.eql(20);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Crear pedido",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"clientName\":\"Carlos Mendoza\",\"items\":[{\"productId\":{{producto_id}},\"quantity\":2}]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Crear pedido responde 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Pedido tiene total y estado correctos', function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.id).to.be.a('number').and.above(0);",
              "  pm.expect(data.clientName).to.eql('Carlos Mendoza');",
              "  pm.expect(data.status).to.eql('PENDIENTE');",
              "  pm.expect(data.total).to.eql(1000);",
              "  pm.expect(data.items[0].productId).to.eql(Number(pm.collectionVariables.get('producto_id')));",
              "  pm.collectionVariables.set('pedido_id', data.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Listar pedidos",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listar pedidos responde 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Lista incluye el pedido creado', function () {",
              "  const data = pm.response.json();",
              "  const id = Number(pm.collectionVariables.get('pedido_id'));",
              "  pm.expect(data).to.be.an('array');",
              "  pm.expect(data.some(p => p.id === id)).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Obtener pedido por ID",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/orders/{{pedido_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Consultar pedido responde 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Recupera el pedido correcto', function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.id).to.eql(Number(pm.collectionVariables.get('pedido_id')));",
              "  pm.expect(data.total).to.eql(1000);",
              "  pm.expect(data.status).to.eql('PENDIENTE');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Pedido con stock insuficiente",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"clientName\":\"Carlos Mendoza\",\"items\":[{\"productId\":{{producto_id}},\"quantity\":999}]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Stock insuficiente responde 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Explica el stock insuficiente', function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.status).to.eql(400);",
              "  pm.expect(data.message).to.include('Stock insuficiente');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Cambiar pedido a PAGADO",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/api/orders/{{pedido_id}}/status?status=PAGADO"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Actualizar estado responde 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Pedido queda PAGADO', function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.id).to.eql(Number(pm.collectionVariables.get('pedido_id')));",
              "  pm.expect(data.status).to.eql('PAGADO');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Cancelar pedido",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/orders/{{pedido_id}}/cancel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cancelar pedido responde 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Confirma la cancelacion del pedido correcto', function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.orderId).to.eql(Number(pm.collectionVariables.get('pedido_id')));",
              "  pm.expect(data.status).to.eql('CANCELADO');",
              "  pm.expect(data.message).to.include('cancelado');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Eliminar producto de prueba",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/api/products/{{producto_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Eliminar producto responde 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Confirma la eliminacion', function () {",
              "  pm.expect(pm.response.json().message).to.include('eliminado');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
